# Secrets. The glob matters as much as the bare name: a plain `.env` rule
# leaves backups like `.env.bak-1785181407` untracked-but-committable, so one
# `git add -A` would publish ANTHROPIC_API_KEY to a public repo.
.env
.env.*
*.env
# ...but .env.example holds no secrets and documents the required vars, so it
# stays tracked. Without this it would be re-ignored if ever removed and re-added.
!.env.example
node_modules/

# Local runtime logs
server.out.log
server.err.log
*.log

# Local Claude Code settings
.claude/*
# ...except skills, which are project knowledge rather than local config
!.claude/skills/

# Captured leads and broker comp submissions (contact info) — never commit
leads.jsonl
comp-submissions.jsonl

# Account store (emails + password hashes; * covers .tmp/.corrupt sidecars) — never commit
account-store.json*

# File fallbacks used only when Supabase isn't configured
search-cache.json
shared-reports.json
analytics.jsonl
market-pages-dynamic.json
comp-corpus.jsonl

# Owner's local planning spreadsheets — not app code
CompNinja*.xlsx


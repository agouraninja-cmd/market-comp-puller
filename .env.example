# Copy this file to ".env" and fill in your key.
# The .env file is loaded automatically by server.js on startup.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — require a shared password before anyone can run searches.
# Leave it commented out to keep the app open.
# APP_PASSWORD=choose-a-shared-password

# Optional — port the server listens on (defaults to 3000)
# PORT=3000

# Optional — lets `node ledger/ledger.js` read BILLED Anthropic cost from the
# Admin Usage & Cost API instead of estimating it, so no month has to be typed
# in from the Console by hand.
#
# This is NOT the sk-ant-api03- key the app runs on. Create it at
#   Console -> Settings -> API keys -> Admin keys
# a section that only exists on ORGANIZATION accounts, and only for members
# with the `admin` role. It reads billing and cannot make model calls.
#
# If the org bills for anything besides CompNinja, pass --workspace as well
# (node ledger/ledger.js --list-workspaces) or the ledger books the WHOLE
# organization's spend as CompNinja's cost.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# Optional — lets `node ledger/ledger.js` import revenue and processing fees
# from Stripe instead of you typing each sale into ledger/manual-entries.csv.
#
# For the LEDGER, do NOT paste the sk_live_ key the server runs on. The ledger
# only ever calls GET /v1/balance_transactions, so a RESTRICTED key with a
# single read permission does the whole job and cannot refund, charge, or
# change anything if it leaks:
#
#   Stripe Dashboard -> Developers -> API keys -> Create restricted key
#   -> set "Balance transactions" to READ, leave every other resource at None
#
# That gives you an rk_live_... key. Paste it below in your local .env.
# (server.js separately needs the full sk_live_ key for checkout — that one
# belongs only in Render's environment, not on a laptop.)
# STRIPE_SECRET_KEY=rk_live_your-restricted-read-only-key

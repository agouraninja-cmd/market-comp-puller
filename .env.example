# Copy this file to ".env" and fill in the key for whichever search
# provider you are running. The .env file is loaded automatically by
# server.js on startup.

# The DEFAULT provider is Gemini (SEARCH_PROVIDER defaults to "gemini"), so
# this is the key a stock checkout needs. Without it the server still boots
# and serves every page — only /api/comps fails — so the symptom is a site
# that looks fine and cannot run a single search. Watch the startup banner:
# it names the variable it is missing.
#
# The project must be on a PAID Google tier; search grounding 429s on the
# free tier and the error does not say which project is at fault.
# Note the key does NOT necessarily start "AIza" — do not reject one that
# looks unfamiliar. To check a key without spending anything:
#   curl -s -H "x-goog-api-key: YOUR_KEY" https://generativelanguage.googleapis.com/v1beta/models
# A 200 with a model list means the key is good.
GEMINI_API_KEY=your-gemini-key-here

# Only needed if you switch to the Anthropic provider by uncommenting the
# line below. An unrecognized SEARCH_PROVIDER value exits at boot rather
# than silently falling back to a default.
# SEARCH_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — require a shared password before anyone can run searches.
# Leave it commented out to keep the app open.
# APP_PASSWORD=choose-a-shared-password

# Optional — port the server listens on (defaults to 3000)
# PORT=3000

# Optional — lets `node ledger/ledger.js` read BILLED Anthropic cost from the
# Admin Usage & Cost API instead of estimating it, so no month has to be typed
# in from the Console by hand.
#
# This is NOT the sk-ant-api03- key the app runs on. Create it at
#   Console -> Settings -> Admin keys      (platform.claude.com/settings/admin-keys)
# It is its own settings page, NOT a section inside the normal API keys page --
# looking for it there is the usual reason people conclude it doesn't exist.
# Only members with the `admin` role (or an owner) see it, and the Admin API is
# unavailable to individual accounts: the account must be an organization.
# It reads billing and cannot make model calls.
#
# Note the org that owns ANTHROPIC_API_KEY must be a Claude CONSOLE org
# (platform.claude.com). A Claude Enterprise org on claude.ai issues a different
# key (sk-ant-api01-) that does NOT cover the usage and cost endpoints.
#
# If the org bills for anything besides CompNinja, pass --workspace as well
# (node ledger/ledger.js --list-workspaces) or the ledger books the WHOLE
# organization's spend as CompNinja's cost.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# Optional — lets `node ledger/ledger.js` import revenue and processing fees
# from Stripe instead of you typing each sale into ledger/manual-entries.csv.
#
# For the LEDGER, do NOT paste the sk_live_ key the server runs on. The ledger
# only ever calls GET /v1/balance_transactions, so a RESTRICTED key with a
# single read permission does the whole job and cannot refund, charge, or
# change anything if it leaks:
#
#   Stripe Dashboard -> Developers -> API keys -> Create restricted key
#   -> set "Balance transactions" to READ, leave every other resource at None
#
# That gives you an rk_live_... key. Paste it below in your local .env.
# (server.js separately needs the full sk_live_ key for checkout — that one
# belongs only in Render's environment, not on a laptop.)
# STRIPE_SECRET_KEY=rk_live_your-restricted-read-only-key

# Optional shared passkey that comps Pro to a signed-in account (beta testers).
# Unset = POST /api/redeem-passkey 404s and the "Have a code?" row never shows.
# NOT the same as ADMIN_KEY, which also unlocks /admin, /dev and /contacts.
# Revoke one tester without changing the code for everyone else:
#   update users set pro_tester = false where email = 'someone@example.com';
# TESTER_PASSKEY=pick-something-long

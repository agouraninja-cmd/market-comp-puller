<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the Mac app may do under Apple's hardened runtime, which comes with
  signing for notarization. The installers are unsigned today, so macOS reads
  none of this yet; it is here so the day the build is signed, the camera
  keeps working instead of failing silently.

  The first three are electron-builder's own defaults
  (app-builder-lib/templates/entitlements.mac.plist): a custom file REPLACES
  that default rather than adding to it, and Electron will not start under the
  hardened runtime without them. The camera is Settings' "Take a selfie";
  NSCameraUsageDescription in package.json is the sentence macOS shows when it
  asks. Used for the app and its helper processes alike (entitlementsInherit),
  because Chromium captures video in a helper. No microphone: nothing asks.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
  </dict>
</plist>
